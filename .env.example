# 아래 AI 키 중 하나만 넣으면 됩니다. (여러 개면 AI_PROVIDER로 고르기)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 선택: gemini | anthropic | openai  (비우면 키가 있는 것 중 자동)
AI_PROVIDER=
# 선택: 모델 이름 직접 지정 (비우면 기본값)
AI_MODEL=

# 선택: YouTube Data API v3 키. 비워도 키 없이 동작합니다.
YOUTUBE_API_KEY=

# 선택: 크롬 실행 파일 경로 (자동으로 못 찾을 때만)
CHROME_PATH=
